{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File <project-root>/tools/agent-events/log-event.ps1",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File <project-root>/tools/agent-events/log-event.ps1",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
